{
  "name": "session-transfer",
  "version": "0.1.0",
  "private": true,
  "description": "Save a Claude conversation in one browser profile and continue it in another.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
